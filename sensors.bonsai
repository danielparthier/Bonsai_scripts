            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="imviz:RollingBufferBuilder">
                <imviz:Capacity>1000</imviz:Capacity>
                <imviz:ValueSelector />
              </Builder>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>box2_temp</Name>
            </Expression>
          </Nodes>
          <Edges>
